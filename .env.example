RAZORPAY_KEY_ID=placeholder
RAZORPAY_KEY_SECRET=placeholder

PORT=placeholder
NODE_ENV=development


ALLOWED_ORIGINS=placeholder

PUBLIC_SITE_URL=placeholder

GMAIL_USER=placeholder
GMAIL_APP_PASSWORD=placeholder  
COACH_EMAIL=placeholder

SUPABASE_URL=placeholder
SUPABASE_PUBLISHABLE_KEY=placeholder
SUPABASE_SECRET_KEY=placeholder
SUPABASE_JWKS_URL=placeholder


RESOURCE_VAULT_PDF_URL=placeholder

ADMIN_JWT_SECRET=placeholder
VERCEL=0
