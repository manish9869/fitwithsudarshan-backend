# Optional — powers the "Live Visitors" widget on the admin dashboard by
# calling the GA4 Realtime Data API. Leave blank to leave that widget off.
# See docs/ga4-live-users-setup.md for how to get these three values.
GA4_PROPERTY_ID=placeholder
GA4_CLIENT_EMAIL=placeholder
GA4_PRIVATE_KEY=placeholder

# WhatsApp marketing module
# Required for the daily scheduler (Vercel Cron sends it as a Bearer token).
# Generate any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=placeholder
# Optional — Meta WhatsApp Cloud API for automatic sending. Leave blank to use
# the free "assisted" mode (send from the admin queue via WhatsApp by hand).
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
